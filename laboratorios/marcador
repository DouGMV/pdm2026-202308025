import 'package:flutter/material.dart';

void main() => runApp(const MaterialApp(home: Marcador()));

class Marcador extends StatefulWidget {
  const Marcador({super.key});
  
  @override
  State<Marcador> createState() => _MarcadorState();
}

class _MarcadorState extends State<Marcador> {
  final String equipoA = 'Equipo A';
  final String equipoB = 'Equipo B';
  int puntosA = 0;
  int puntosB = 0;
  
  String get mensaje {
    if (puntosA == puntosB) return 'Empate';
    return 'Va ganando ${puntosA > puntosB ? equipoA : equipoB}';
  }
  
  Widget tarjeta(String nombre, int puntos, bool ganando,
      VoidCallback sumar, VoidCallback restar) {
    return Container(
      padding: const EdgeInsets.all(16),
      margin: const EdgeInsets.all(8),
      color: ganando ? Colors.green : Colors.grey[300],
      child: Column(
        children: [
          Text(nombre, style: const TextStyle(fontSize: 22)),
          Text('$puntos', style: const TextStyle(fontSize: 40)),
          Row(
            mainAxisAlignment: MainAxisAlignment.center, // Corregido
            children: [
              ElevatedButton(onPressed: restar, child: const Text('-1')),
              const SizedBox(width: 10),
              ElevatedButton(onPressed: sumar, child: const Text('+1')),
            ],
          ),
        ],
      ),
    );
  }
  
  @override
  Widget build(BuildContext context) {
    return Scaffold( // Corregido a mayúscula
      appBar: AppBar(title: const Text('Marcador')), // Corregido a 'title'
      body: Center(
        child: Column(
          mainAxisAlignment: MainAxisAlignment.center, // Corregido
          children: [
            tarjeta(
              equipoA,
              puntosA,
              puntosA > puntosB,
              () => setState(() => puntosA++),
              () => setState(() { if (puntosA > 0) puntosA--; }),
           ),
           tarjeta(
              equipoB,
              puntosB,
              puntosB > puntosA,
              () => setState(() => puntosB++),
              () => setState(() { if (puntosB > 0) puntosB--; }),
           ),
           const SizedBox(height: 20),
           Text(mensaje, style: const TextStyle(fontSize: 24)),
           const SizedBox(height: 20),
           ElevatedButton(
            onPressed: () => setState(() {
              puntosA = 0;
              puntosB = 0;
            }),
            child: const Text('Reiniciar'),
           ),
          ],
        ),
      ),
    );
  }
}
